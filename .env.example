# Optional only: the fictional boardroom and C02/C06/C13 need no credentials.
# Copy to .env locally; keep secrets out of Git and release archives.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Relative data/index paths resolve from the project directory. Blank uses defaults.
VERDANT_DATA_DIR=./data_cache
VERDANT_RAG_DIR=./rag_db
# Blank uses <VERDANT_DATA_DIR>/feedback.db.
VERDANT_FEEDBACK_DB=
# Provider choices: auto, gemini, openrouter. Install requirements-llm.txt first.
# Outbound destinations: generativelanguage.googleapis.com; openrouter.ai.
# Optional market downloads require Yahoo Finance endpoints.
# Optional RAG model downloads require Hugging Face access and requirements-rag.txt.
